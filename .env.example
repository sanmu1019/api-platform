# 环境变量覆盖示例
#
# 本项目读取配置的优先级：
#   config.json  <  API_PLATFORM_* 环境变量
#
# 规则：环境变量名 = "API_PLATFORM_" + config.json 里的字段名大写。
# 只要环境变量存在，就会覆盖 config.json 中的同名配置；config.json 不存在时，
# 程序使用 core/config.py 里的默认值（因此 CI / 容器里可以完全不挂 config.json）。
#
# 用法：
#   docker compose --env-file .env up -d
#
# ⚠️ 本项目**没有 dotenv 依赖**：core/config.py 只读 os.environ，
#    `python main.py` **不会**自动加载 .env 文件。本地开发想用环境变量，
#    请直接在 shell 里 export，例如：
#      export API_PLATFORM_ADMIN_TOKEN=$(python -c "import secrets;print(secrets.token_urlsafe(32))")
#    或者直接改 config.json（环境变量优先级高于 config.json）。
#
# ⚠️ `--env-file` 只影响 compose 文件里 ${VAR} 的插值，**不会**把变量注入容器。
#    要让容器真正拿到这些变量，需在 docker-compose.yml 的服务里加
#    `env_file: [.env]`，或把它们写进 `environment:`。
#
# 注意：.env 已被 .gitignore 忽略，切勿把真实凭据提交到仓库。

# ---------- 运行环境 ----------
API_PLATFORM_ENVIRONMENT=production
API_PLATFORM_DEBUG=false
API_PLATFORM_HOST=127.0.0.1
API_PLATFORM_PORT=8000
API_PLATFORM_DATABASE_PATH=./data/api_platform.sqlite3

# ---------- 凭据（生产必须改成强随机值，否则 production 下拒绝启动）----------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_PLATFORM_ADMIN_TOKEN=
# 格式：key1:备注1,key2:备注2
API_PLATFORM_DEFAULT_API_KEYS=

# ---------- 访问控制 ----------
API_PLATFORM_REQUIRE_API_KEY=false
API_PLATFORM_ALLOW_SELF_REGISTER=false
API_PLATFORM_SELF_REGISTER_QUOTA_PER_DAY=100
API_PLATFORM_RATE_LIMIT_PER_MINUTE=120
API_PLATFORM_ADMIN_IP_ALLOWLIST=
API_PLATFORM_ADMIN_LOGIN_FAIL_LIMIT=5
API_PLATFORM_ADMIN_LOGIN_FAIL_WINDOW_SECONDS=300
API_PLATFORM_ADMIN_PUBLIC_PATH=/manage-api
API_PLATFORM_SHOW_ADMIN_ENTRY=false
API_PLATFORM_PUBLIC_SECURITY_ENABLED=true

# ---------- 跨域 / 业务开关 ----------
# 逗号分隔；为空表示不启用 CORS 中间件
API_PLATFORM_CORS_ORIGINS=
API_PLATFORM_ENABLE_DOUYIN=true
